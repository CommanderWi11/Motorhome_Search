<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Motorhome Lifestyle — refreshes today's Top 5, once a day, 03:00 local.

  Install:
    ln -sf "/Users/openbob/Library/Mobile Documents/com~apple~CloudDocs/AI Coworking/01_Personal_HQ/Projects/Motorhome_HQ/Motorhome_Search/launchd/com.openbob.motorhome-search-daily.plist" ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.openbob.motorhome-search-daily.plist

  Force a run now (does not wait for the next scheduled slot):
    launchctl kickstart -k gui/$(id -u)/com.openbob.motorhome-search-daily

  Watch it:
    tail -f ~/Library/Logs/motorhome-daily.log

  Uninstall:
    launchctl bootout gui/$(id -u)/com.openbob.motorhome-search-daily

  Note: this runs on YOUR Mac on purpose. GitHub Actions cannot do this job — the
  listing sites block datacenter IPs, which is why the old weekly-search.yml never
  produced a single listing. The trade-off is that the Mac must be awake; if it is
  asleep at 03:00 launchd runs the job on next wake, and the idempotency marker in
  weekly-search.sh makes sure it still only runs once per CALENDAR DAY.

  2026-07-20: renamed from com.openbob.camper-weekly (Camper_Lifestyle repo) as part
  of consolidating the project into AI Coworking as Motorhome_HQ/Motorhome_Search.
  2026-07-21: switched from Monday-only to every day, at Luis's request — the board
  stays WEEK-keyed (board.py), this just refreshes the current week's Top 5 more
  often instead of locking it after the first successful run of the week. Renamed
  from com.openbob.motorhome-search-weekly accordingly. See MEMORY.md.
  2026-07-30: search scope refocused to the Canary Islands only (used + new), and
  the schedule collapsed from 07:00/13:00/19:00 (one real run + two same-day
  retries) down to a single 03:00 run, at Luis's explicit request. Trade-off: a
  Stage B failure (session limit, hang, flaky site) no longer gets a same-day
  retry — the next attempt is tomorrow's 03:00. Known risk: the 2026-07-27 MEMORY.md
  entry documents Claude's daily session limit resetting at 3:20am Atlantic/Canary
  — 03:00 is 20 minutes BEFORE that reset, so some days may still hit the limit
  Stage B needs to run cleanly. If that starts happening in the log, the fix is a
  one-line change to Hour/Minute below (e.g. bump to 03:25).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openbob.motorhome-search-daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/openbob/Library/Mobile Documents/com~apple~CloudDocs/AI Coworking/01_Personal_HQ/Projects/Motorhome_HQ/Motorhome_Search/scripts/weekly-search.sh</string>
  </array>

  <!-- No WorkingDirectory: the script cd's itself. (Matches the convention set
       after the com.openbob.binter-payslips incident, 2026-07-11.) -->

  <!--
    2026-07-30: single 03:00 run, no retries — Luis's explicit request when
    refocusing search scope to the Canary Islands only. Before this, 07:00 was the
    real daily run with 13:00/19:00 as RETRIES for when Stage B failed for reasons
    that have nothing to do with the code: a Claude session limit, a flaky site, no
    network on wake. (The very first launchd run, on 2026-07-13, died exactly this
    way — on a session limit. The 2026-07-20 19:00 retry also hung with zero session
    activity and had to be killed and rerun manually — see MEMORY.md.) That safety
    net is gone now: a failed 03:00 run means no fresh board until tomorrow's 03:00.
    No `Weekday` key below, on purpose — every day fires.
  -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/openbob/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/openbob/Library/Logs/motorhome-daily.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/openbob/Library/Logs/motorhome-daily.log</string>
</dict>
</plist>
